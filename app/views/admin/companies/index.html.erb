<% content_for :title, t("admin.companies.page_title") %>

<div class="d-flex align-items-baseline justify-content-between mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0"><%= t("admin.companies.heading") %></h1>
    <small class="text-secondary"><%= t("admin.companies.subtitle") %></small>
  </div>
  <div class="d-flex align-items-center gap-2">
    <%= render "shared/filters_toggle", target: "companies-filters", count: active_filters_count %>
    <% if active_filters_count.positive? %>
      <%= link_to t("filters.clear"), admin_companies_path, class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
    <span class="badge text-bg-light"><%= t("admin.companies.total", count: @companies.total) %></span>
  </div>
</div>

<div data-controller="auto-submit">
  <div class="collapse <%= "show" if active_filters_count.positive? %>" id="companies-filters">
    <div class="card card-body mb-3">
      <%= form_with url: admin_companies_path, method: :get, local: true do %>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small text-secondary" for="name"><%= t("filters.name_label") %></label>
            <%= text_field_tag :name, params[:name],
                               class: "form-control form-control-sm",
                               placeholder: t("filters.name_placeholder"),
                               data: {action: "input->auto-submit#submitDebounced"} %>
          </div>
          <div class="col-md-6">
            <label class="form-label small text-secondary" for="type"><%= t("admin.companies.filters.type_label") %></label>
            <%= select_tag :type,
                  options_for_select(
                    [[t("common.all"), ""],
                     [t("admin.companies.filters.type_platform"), "platform"],
                     [t("admin.companies.filters.type_tenant"), "tenant"]],
                    params[:type]
                  ),
                  class: "form-select form-select-sm",
                  data: {action: "change->auto-submit#submit"} %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.companies.headers.id") %></th>
          <th scope="col"><%= t("admin.companies.headers.name") %></th>
          <th scope="col"><%= t("admin.companies.headers.type") %></th>
          <th scope="col" class="text-end"><%= t("admin.companies.headers.users") %></th>
          <th scope="col" class="text-end"><%= t("admin.companies.headers.teams") %></th>
          <th scope="col" class="text-end"><%= t("admin.companies.headers.lockers") %></th>
        </tr>
      </thead>
      <tbody>
        <% @companies.each do |company| %>
          <tr>
            <td class="text-secondary"><%= company.id %></td>
            <td class="fw-semibold">
              <%= link_to company.name, admin_teams_path(company_id: company.id), class: "text-decoration-none" %>
            </td>
            <td>
              <% if company.platform_owner? %>
                <span class="badge text-bg-primary"><%= t("admin.companies.type.platform") %></span>
              <% else %>
                <span class="badge text-bg-secondary"><%= t("admin.companies.type.tenant") %></span>
              <% end %>
            </td>
            <td class="text-end">
              <%= link_to company.users_count, admin_users_path(company_id: company.id), class: "badge text-bg-light border text-decoration-none" %>
            </td>
            <td class="text-end">
              <%= link_to company.teams_count, admin_teams_path(company_id: company.id), class: "badge text-bg-light border text-decoration-none" %>
            </td>
            <td class="text-end">
              <%= link_to company.lockers_count, admin_lockers_path(company_id: company.id), class: "badge text-bg-light border text-decoration-none" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= render "shared/pagination", pagination: @companies %>
