<% content_for :title, @physical_device.device_id %>

<nav aria-label="breadcrumb" class="mb-3">
  <%= link_to t("physical_devices.show.back_to_list"), admin_physical_devices_path, class: "text-decoration-none small" %>
</nav>

<h1 class="h3 mb-1"><code><%= @physical_device.device_id %></code></h1>
<div class="text-secondary small mb-4">
  <%= @physical_device.model.presence || t("physical_devices.no_model") %>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold"><%= t("physical_devices.show.history_heading") %></div>
  <div class="card-body">
    <% if @ownership_history.any? %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr class="small text-secondary">
              <th scope="col"></th>
              <th scope="col">Owner</th>
              <th scope="col">Locker name</th>
              <th scope="col">Started</th>
              <th scope="col">Ended</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @ownership_history.each do |locker| %>
              <tr>
                <td>
                  <% if locker.active? %>
                    <span class="badge text-bg-success"><%= t("physical_devices.show.current_label") %></span>
                  <% else %>
                    <span class="badge text-bg-light border"><%= t("physical_devices.show.archived_label") %></span>
                  <% end %>
                </td>
                <td><%= locker_owner_badge(locker) %></td>
                <td>
                  <% if locker.active? %>
                    <%= link_to locker.name, admin_locker_path(locker), class: "text-decoration-none fw-semibold" %>
                  <% else %>
                    <span class="fw-semibold"><%= locker.name %></span>
                  <% end %>
                </td>
                <td class="small text-secondary"><%= l(locker.started_at, format: :short) %></td>
                <td class="small text-secondary">
                  <%= locker.ended_at ? l(locker.ended_at, format: :short) : t("physical_devices.show.no_end") %>
                </td>
                <td class="text-end small">
                  <%= t("physical_devices.show.actions_count", count: locker.locker_actions.length) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-secondary fst-italic mb-0"><%= t("physical_devices.show.history_empty") %></p>
    <% end %>
  </div>
</div>
