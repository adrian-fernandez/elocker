<% content_for :title, t("admin.teams.page_title") %>

<div class="d-flex align-items-baseline justify-content-between mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0"><%= t("admin.teams.heading") %></h1>
    <small class="text-secondary"><%= t("admin.teams.subtitle") %></small>
  </div>
  <div class="d-flex align-items-center gap-2">
    <%= render "shared/filters_toggle", target: "teams-filters", count: active_filters_count %>
    <% if active_filters_count.positive? %>
      <%= link_to t("filters.clear"), admin_teams_path, class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
    <span class="badge text-bg-light"><%= t("admin.teams.total", count: @teams.total) %></span>
  </div>
</div>

<div data-controller="auto-submit">
  <div class="collapse <%= "show" if active_filters_count.positive? %>" id="teams-filters">
    <div class="card card-body mb-3">
      <%= form_with url: admin_teams_path, method: :get, local: true do %>
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label small text-secondary" for="name"><%= t("filters.name_label") %></label>
            <%= text_field_tag :name, params[:name],
                               class: "form-control form-control-sm",
                               placeholder: t("filters.name_placeholder"),
                               data: {action: "input->auto-submit#submitDebounced"} %>
          </div>
          <div class="col-md-3">
            <label class="form-label small text-secondary" for="company_id"><%= t("admin.teams.filters.company_label") %></label>
            <%= select_tag :company_id,
                  options_from_collection_for_select(@companies, :id, :name, params[:company_id]),
                  include_blank: t("common.all"),
                  class: "form-select form-select-sm",
                  data: {action: "change->auto-submit#submit"} %>
          </div>
          <div class="col-md-3">
            <label class="form-label small text-secondary" for="members"><%= t("filters.members_label") %></label>
            <%= text_field_tag :members, params[:members],
                               class: "form-control form-control-sm",
                               placeholder: t("filters.member_placeholder"),
                               data: {action: "input->auto-submit#submitDebounced"} %>
          </div>
          <div class="col-md-3">
            <label class="form-label small text-secondary" for="lockers"><%= t("filters.lockers_label") %></label>
            <%= text_field_tag :lockers, params[:lockers],
                               class: "form-control form-control-sm",
                               placeholder: t("filters.locker_placeholder"),
                               data: {action: "input->auto-submit#submitDebounced"} %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.teams.headers.id") %></th>
          <th scope="col"><%= t("admin.teams.headers.name") %></th>
          <th scope="col"><%= t("admin.teams.headers.company") %></th>
          <th scope="col"><%= t("admin.teams.headers.members") %></th>
          <th scope="col"><%= t("admin.teams.headers.lockers") %></th>
        </tr>
      </thead>
      <tbody>
        <% @teams.each do |team| %>
          <tr>
            <td class="text-secondary"><%= team.id %></td>
            <td class="fw-semibold">
              <%= link_to team.name, admin_users_path(team_id: team.id), class: "text-decoration-none" %>
            </td>
            <td>
              <%= link_to team.company.name, admin_teams_path(company_id: team.company_id), class: "text-decoration-none" %>
            </td>
            <td>
              <% if team.users.any? %>
                <% team.users.each do |user| %>
                  <%= link_to user.name, admin_users_path(name: user.name), class: "badge text-bg-light border me-1 text-decoration-none" %>
                <% end %>
              <% else %>
                <span class="text-secondary fst-italic"><%= t("common.no_members") %></span>
              <% end %>
            </td>
            <td>
              <% if team.lockers.any? %>
                <% team.lockers.each do |locker| %>
                  <%= link_to locker.name, admin_locker_path(locker), class: "badge text-bg-light border me-1 text-decoration-none" %>
                <% end %>
              <% else %>
                <span class="text-secondary fst-italic"><%= t("common.none") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= render "shared/pagination", pagination: @teams %>
