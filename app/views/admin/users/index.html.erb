<% content_for :title, t("admin.users.page_title") %>

<div class="d-flex align-items-baseline justify-content-between mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0"><%= t("admin.users.heading") %></h1>
    <small class="text-secondary"><%= t("admin.users.subtitle") %></small>
  </div>
  <div class="d-flex align-items-center gap-2">
    <% if filter_params.any? %>
      <%= link_to t("filters.clear"), admin_users_path, class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
    <span class="badge text-bg-light"><%= t("admin.users.total", count: @pagination.total) %></span>
  </div>
</div>

<div data-controller="auto-submit">
  <%= form_with url: admin_users_path, method: :get, local: true, html: { id: "admin-filters" } do %><% end %>

  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.users.headers.id") %></th>
          <th scope="col"><%= t("admin.users.headers.name") %></th>
          <th scope="col"><%= t("admin.users.headers.company") %></th>
          <th scope="col"><%= t("admin.users.headers.access") %></th>
          <th scope="col"><%= t("admin.users.headers.teams") %></th>
        </tr>
        <tr class="table-light small">
          <th></th>
          <th>
            <%= text_field_tag :name, params[:name],
                               form: "admin-filters",
                               class: "form-control form-control-sm",
                               placeholder: t("filters.name_placeholder"),
                               data: { action: "input->auto-submit#submitDebounced" } %>
          </th>
          <th>
            <%= select_tag :company_id,
                  options_from_collection_for_select(@companies, :id, :name, params[:company_id]),
                  include_blank: t("common.all"),
                  form: "admin-filters",
                  class: "form-select form-select-sm",
                  data: { action: "change->auto-submit#clearThen", clear: "team_id" } %>
          </th>
          <th></th>
          <th>
            <% team_options =
                 if params[:company_id].present?
                   options_from_collection_for_select(@teams, :id, :name, params[:team_id])
                 else
                   grouped_options_for_select(
                     @teams.group_by { |t| t.company.name }.transform_values { |ts| ts.map { |t| [t.name, t.id] } },
                     params[:team_id]
                   )
                 end %>
            <%= select_tag :team_id, team_options,
                  include_blank: t("common.all"),
                  form: "admin-filters",
                  class: "form-select form-select-sm",
                  data: { action: "change->auto-submit#submit" } %>
          </th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="text-secondary"><%= user.id %></td>
            <td class="fw-semibold"><%= user.name %></td>
            <td>
              <%= link_to user.company.name, admin_teams_path(company_id: user.company_id), class: "text-decoration-none" %>
            </td>
            <td>
              <% if user.platform_owner? %>
                <span class="badge text-bg-primary"><%= t("admin.users.access.platform") %></span>
              <% else %>
                <span class="badge text-bg-secondary"><%= t("admin.users.access.tenant") %></span>
              <% end %>
            </td>
            <td>
              <% if user.platform_owner? %>
                <span class="text-secondary fst-italic"><%= t("admin.users.access.full_access_note") %></span>
              <% elsif user.teams.any? %>
                <% user.teams.each do |team| %>
                  <%= link_to team.name, admin_users_path(team_id: team.id), class: "badge text-bg-light border me-1 text-decoration-none" %>
                <% end %>
              <% else %>
                <span class="text-secondary fst-italic"><%= t("common.no_teams") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= render "shared/pagination", pagination: @pagination %>
