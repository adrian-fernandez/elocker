<% content_for :title, t("locker.transfer.page_title") %>

<nav aria-label="breadcrumb" class="mb-3">
  <%= link_to t("locker.back_to_list"), admin_locker_path(@locker), class: "text-decoration-none small" %>
</nav>

<h1 class="h3 mb-3"><%= t("locker.transfer.heading", name: @locker.name) %></h1>
<p class="text-secondary mb-4"><%= t("locker.transfer.intro_html") %></p>

<div class="card">
  <div class="card-body">
    <%= form_with url: transfer_admin_locker_path(@locker), method: :post, local: true do %>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label text-secondary"><%= t("locker.transfer.current_label") %></label>
          <div class="form-control-plaintext">
            <%= locker_owner_badge(@locker) %>
            <span class="text-secondary mx-1">·</span>
            <code><%= @locker.device_id %></code>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label" for="company_id"><%= t("locker.transfer.new_company_label") %></label>
          <%= select_tag :company_id,
                options_from_collection_for_select(@companies, :id, :name),
                include_blank: t("locker.transfer.unassigned_option"),
                class: "form-select" %>
        </div>

        <div class="col-md-6">
          <label class="form-label" for="name"><%= t("locker.transfer.new_name_label") %></label>
          <%= text_field_tag :name, @locker.name, class: "form-control", required: true %>
          <small class="form-text text-secondary"><%= t("locker.transfer.new_name_hint") %></small>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= submit_tag t("locker.transfer.submit"), class: "btn btn-primary" %>
        <%= link_to t("locker.transfer.cancel"), admin_locker_path(@locker), class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
