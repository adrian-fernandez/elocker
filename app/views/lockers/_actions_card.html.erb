<%
  # Locals:
  # - locker:        Locker
  # - open_path:     String — POST target for the Open operation
  # - close_path:    String — POST target for the Close operation
  # - transfer_path: String or nil — admin-only link to the transfer form
%>
<div class="card">
  <div class="card-header fw-semibold"><%= t("locker.actions.heading") %></div>
  <div class="card-body d-grid gap-2">
    <% if locker.closed? %>
      <%= button_to t("locker.actions.open"),
            open_path,
            method: :post,
            class: "btn btn-success w-100",
            data: { turbo_confirm: t("locker.actions.confirm_open") } %>
    <% else %>
      <%= button_to t("locker.actions.close"),
            close_path,
            method: :post,
            class: "btn btn-outline-secondary w-100",
            data: { turbo_confirm: t("locker.actions.confirm_close") } %>
    <% end %>

    <% if transfer_path %>
      <%= link_to t("locker.actions.transfer"),
            transfer_path,
            class: "btn btn-outline-primary btn-sm w-100" %>
    <% end %>
  </div>
</div>
