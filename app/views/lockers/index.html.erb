<% content_for :title, t("lockers.page_title") %>

<%= turbo_stream_from "lockers" %>

<div class="d-flex align-items-baseline justify-content-between mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0"><%= t("lockers.heading") %></h1>
    <small class="text-secondary"><%= t("lockers.subtitle") %></small>
  </div>
  <div class="d-flex align-items-center gap-2">
    <%= render "shared/filters_toggle", target: "client-lockers-filters", count: active_filters_count %>
    <% if active_filters_count.positive? %>
      <%= link_to t("filters.clear"), lockers_path, class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
    <span class="badge text-bg-light"><%= t("lockers.total", count: @lockers.total) %></span>
  </div>
</div>

<div data-controller="auto-submit">
  <div class="collapse <%= "show" if active_filters_count.positive? %>" id="client-lockers-filters">
    <div class="card card-body mb-3">
      <%= form_with url: lockers_path, method: :get, local: true do %>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small text-secondary" for="name"><%= t("filters.name_label") %></label>
            <%= text_field_tag :name, params[:name],
                               class: "form-control form-control-sm",
                               placeholder: t("filters.name_placeholder"),
                               data: {action: "input->auto-submit#submitDebounced"} %>
          </div>
          <div class="col-md-6">
            <label class="form-label small text-secondary" for="status"><%= t("lockers.filters.status_label") %></label>
            <%= select_tag :status,
                  options_for_select(
                    [[t("common.all"), ""],
                     [t("lockers.status.open"), "open"],
                     [t("lockers.status.closed"), "closed"]],
                    params[:status]
                  ),
                  class: "form-select form-select-sm",
                  data: {action: "change->auto-submit#submit"} %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @lockers.any? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th scope="col"><%= t("lockers.headers.id") %></th>
            <th scope="col"><%= t("lockers.headers.name") %></th>
            <th scope="col"><%= t("lockers.headers.device_id") %></th>
            <th scope="col"><%= t("lockers.headers.status") %></th>
            <th scope="col"><%= t("lockers.headers.last_change") %></th>
          </tr>
        </thead>
        <tbody>
          <% @lockers.each do |locker| %>
            <tr>
              <td class="text-secondary"><%= locker.id %></td>
              <td class="fw-semibold">
                <%= link_to locker.name, locker_path(locker), class: "text-decoration-none" %>
              </td>
              <td><code><%= locker.device_id %></code></td>
              <td><%= locker_status_badge(locker.status) %></td>
              <td class="small">
                <% if locker.last_status_changed_at %>
                  <div><%= l(locker.last_status_changed_at, format: :short) %></div>
                  <div class="text-secondary">
                    <% if locker.last_status_changed_by %>
                      <%= t("lockers.last_change.by_html", name: h(locker.last_status_changed_by.name)) %>
                    <% else %>
                      <%= t("lockers.last_change.by_device") %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-secondary"><%= t("lockers.last_change.never") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-light border" role="status">
      <%= t("lockers.empty") %>
    </div>
  <% end %>
</div>

<%= render "shared/pagination", pagination: @lockers %>
