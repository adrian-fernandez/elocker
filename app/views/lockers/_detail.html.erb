<%
  # Locals:
  # - locker, back_path, open_path, close_path, force_open_path, force_close_path
  # - admin:         Boolean — whether we're rendering under /admin (controls deep links)
  # - transfer_path: String or nil — admin-only link to the transfer form
  transfer_path = local_assigns[:transfer_path]
%>

<%= turbo_stream_from "lockers" %>

<nav aria-label="breadcrumb" class="mb-3">
  <%= link_to t("locker.back_to_list"), back_path, class: "text-decoration-none small" %>
</nav>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1"><%= locker.name %></h1>
    <div class="text-secondary small">
      <code><%= locker.device_id %></code>
      <span class="mx-1">·</span>
      <%= locker_owner_badge(locker) %>
    </div>
  </div>
  <div>
    <%= locker_status_badge(locker.status, size: :lg) %>
  </div>
</div>

<div class="row g-3">
  <div class="col-12 col-lg-5">
    <%= render "lockers/details_card", locker:, admin: %>

    <div class="mt-3">
      <%= render "lockers/actions_card",
            locker:,
            open_path:,
            close_path:,
            force_open_path:,
            force_close_path:,
            transfer_path: %>
    </div>
  </div>

  <div class="col-12 col-lg-7">
    <%= render "lockers/teams_card", locker:, admin: %>
  </div>
</div>
