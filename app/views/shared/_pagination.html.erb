<%
  # Locals:
  # - pagination: Pagination instance
  filter_params = request.query_parameters.except("page", "per_page")
%>

<nav class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3" aria-label="<%= t('pagination.aria_label') %>">
  <small class="text-secondary">
    <% if pagination.total.zero? %>
      <%= t("pagination.empty") %>
    <% else %>
      <%= t("pagination.showing_html", from: pagination.range_from, to: pagination.range_to, total: pagination.total) %>
    <% end %>
  </small>

  <%= form_with url: url_for, method: :get, local: true, data: { controller: "auto-submit" }, class: "d-flex align-items-center gap-2 mb-0" do %>
    <% filter_params.each do |key, value| %>
      <% Array(value).each do |v| %>
        <%= hidden_field_tag key, v, id: nil %>
      <% end %>
    <% end %>

    <label for="per_page" class="form-label mb-0 small text-secondary"><%= t("pagination.per_page") %></label>
    <select name="per_page"
            id="per_page"
            class="form-select form-select-sm"
            style="width: auto;"
            data-action="change->auto-submit#submit">
      <% Pagination::PER_PAGE_OPTIONS.each do |opt| %>
        <option value="<%= opt %>" <%= 'selected' if opt == pagination.per_page %>><%= opt %></option>
      <% end %>
    </select>
  <% end %>

  <ul class="pagination pagination-sm m-0">
    <li class="page-item <%= 'disabled' if pagination.first_page? %>">
      <% if pagination.first_page? %>
        <span class="page-link" aria-hidden="true"><%= t("pagination.prev") %></span>
      <% else %>
        <%= link_to t("pagination.prev"),
                    filter_params.merge(page: pagination.page - 1, per_page: pagination.per_page),
                    class: "page-link",
                    aria: { label: t("pagination.prev") },
                    rel: "prev" %>
      <% end %>
    </li>
    <li class="page-item disabled" aria-current="page">
      <span class="page-link">
        <%= t("pagination.page_of", page: pagination.page, total: pagination.page_count) %>
      </span>
    </li>
    <li class="page-item <%= 'disabled' if pagination.last_page? %>">
      <% if pagination.last_page? %>
        <span class="page-link" aria-hidden="true"><%= t("pagination.next") %></span>
      <% else %>
        <%= link_to t("pagination.next"),
                    filter_params.merge(page: pagination.page + 1, per_page: pagination.per_page),
                    class: "page-link",
                    aria: { label: t("pagination.next") },
                    rel: "next" %>
      <% end %>
    </li>
  </ul>
</nav>
