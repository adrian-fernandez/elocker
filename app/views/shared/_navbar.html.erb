<nav class="navbar navbar-expand-lg bg-dark border-bottom border-secondary" data-bs-theme="dark">
  <div class="container-fluid">
    <%= link_to t("navbar.brand"), root_path, class: "navbar-brand fw-semibold" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primary-nav" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="primary-nav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if platform_owner? %>
          <li class="nav-item">
            <%= link_to t("navbar.companies"), admin_companies_path, class: "nav-link #{'active' if controller_path == 'admin/companies'}" %>
          </li>
          <li class="nav-item">
            <%= link_to t("navbar.teams"), admin_teams_path, class: "nav-link #{'active' if controller_path == 'admin/teams'}" %>
          </li>
          <li class="nav-item">
            <%= link_to t("navbar.users"), admin_users_path, class: "nav-link #{'active' if controller_path == 'admin/users'}" %>
          </li>
          <li class="nav-item">
            <%= link_to t("navbar.lockers"), admin_lockers_path, class: "nav-link #{'active' if controller_path == 'admin/lockers'}" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to t("navbar.lockers"), lockers_path, class: "nav-link #{'active' if controller_path == 'lockers'}" %>
          </li>
        <% end %>
        <li class="nav-item">
          <%= link_to t("navbar.activity"), activity_path, class: "nav-link #{'active' if controller_path == 'activity'}" %>
        </li>
      </ul>

      <div class="dropdown">
        <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('navbar.switcher.aria_label') %>">
          <%= current_user.name %>
          <span class="badge text-bg-secondary ms-1"><%= current_user.company.name %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <%
            companies_with_users =
              User
                .includes(:company)
                .to_a
                .group_by(&:company)
                .sort_by { |company, _| [company.platform_owner? ? 0 : 1, company.name] }
          %>
          <% companies_with_users.each_with_index do |(company, users), i| %>
            <% if i.positive? %>
              <li><hr class="dropdown-divider"></li>
            <% end %>
            <li>
              <h6 class="dropdown-header">
                <%= company.name %>
                <% if company.platform_owner? %>
                  <span class="badge text-bg-primary ms-1"><%= t("navbar.switcher.platform_badge") %></span>
                <% end %>
              </h6>
            </li>
            <% users.sort_by(&:name).each do |user| %>
              <li>
                <%= button_to user.name,
                      session_path,
                      params: { user_id: user.id },
                      method: :patch,
                      class: "dropdown-item #{'active' if user.id == current_user.id}",
                      form: { class: "m-0" } %>
              </li>
            <% end %>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</nav>
