#!/bin/bash
# One-shot: build the images, start the containers, prepare and seed the DB.
# Idempotent -- safe to re-run after `docker compose down -v` or a fresh clone.
set -euo pipefail

echo "== Building images and starting containers =="
docker compose up -d --build

echo "== Waiting for Postgres to accept connections =="
until docker compose exec -T db pg_isready -U postgres -q; do
  sleep 1
done

echo "== Preparing database and loading seeds =="
docker compose exec -T web bin/rails db:prepare db:seed

echo
echo "Ready -- open http://localhost:3000"
